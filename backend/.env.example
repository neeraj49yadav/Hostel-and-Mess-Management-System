# ==============================================================================
# 🏨 HOSTEL & MESS MANAGEMENT SYSTEM - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=production

# Local Data File Fallback Path
DATA_FILE=./data/db.json

# JWT Auth Secret (Change this to a strong random secret)
JWT_SECRET=hostel_mess_admin_pro_super_secret_jwt_key_2026_secure!
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (* for all or specify your Flutter Web URL)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW_MS=900000

# ==============================================================================
# ⚡ SUPABASE CLOUD DATABASE (FREE TIER)
# ==============================================================================
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
